    "openrouter": {
      "protocol": "openai-compatible",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "openai/gpt-4o-mini",
      "api_key_env": "OPENROUTER_API_KEY",
      "stream": true
    },
    "ollama": {
      "protocol": "openai-compatible",
